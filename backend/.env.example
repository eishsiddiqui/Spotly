# Port for backend server (defaults to 5000)
PORT=5000

# MongoDB Connection String (e.g., MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/spotly?retryWrites=true&w=majority

# Secret key used for signing JWT tokens
JWT_KEY=your_super_secret_jwt_key_here

# Geoapify API Key for address forward geocoding (https://www.geoapify.com/)
GEOAPIFY_API_KEY=your_geoapify_api_key_here
